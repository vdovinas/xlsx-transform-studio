{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XLSX Studio",
  "version": "1.0.0",
  "identifier": "local.xlsx.studio",
  "build": {
    "frontendDist": "../desktop/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XLSX Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../tools/engine/": "engine/",
      "../src/main/resources/profiles.json": "profiles.json"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
